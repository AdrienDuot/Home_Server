# =====================================================================
#  Configuration du serveur — copier ce fichier en .env :
#     cp .env.example .env
#  (le script scripts/install.sh le fait automatiquement et génère
#   les mots de passe pour toi)
#  ⚠ Ne jamais mettre le fichier .env sur GitHub (il est dans .gitignore)
# =====================================================================

# --- Général ----------------------------------------------------------
# Adresse IP locale du serveur (ex : 192.168.1.50) — voir : hostname -I
SERVER_IP=192.168.1.50
# Fuseau horaire
TZ=Europe/Paris
# Ton utilisateur Linux (voir : id -u / id -g)
PUID=1000
PGID=1000

# --- Emplacements des données -----------------------------------------
# Configurations et bases de données des applis (petit, idéalement sur SSD)
APPDATA=/srv/homeserver/appdata
# Photos Immich (gros, sur le disque le plus grand)
PHOTOS_LOCATION=/srv/homeserver/photos
# Films et séries pour Jellyfin (contient films/ et series/)
MEDIA_LOCATION=/srv/homeserver/media

# --- Immich -----------------------------------------------------------
# "release" = dernière version. Pour figer une version : v3.1.0 par ex.
IMMICH_VERSION=release
# Uniquement lettres et chiffres (A-Za-z0-9)
IMMICH_DB_PASSWORD=change-moi
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich

# --- Vaultwarden ------------------------------------------------------
# Adresse HTTPS par laquelle tu accèdes à Vaultwarden (voir README, Tailscale)
VAULTWARDEN_DOMAIN=https://mon-serveur.tailnet-xxxx.ts.net:8443
# true pour créer ton compte, puis remettre false et relancer
VAULTWARDEN_SIGNUPS_ALLOWED=true
# Jeton de la page /admin (laisser vide pour désactiver la page admin)
VAULTWARDEN_ADMIN_TOKEN=

# --- Homepage ---------------------------------------------------------
# Adresses autorisées pour ouvrir Homepage, séparées par des virgules
# (ajoute le nom Tailscale si besoin, ex : mon-serveur:3000)
HOMEPAGE_ALLOWED_HOSTS=192.168.1.50:3000,localhost:3000
# Clés API (optionnel) pour afficher des statistiques dans Homepage
HOMEPAGE_JELLYFIN_KEY=
HOMEPAGE_IMMICH_KEY=
HOMEPAGE_SEERR_KEY=
